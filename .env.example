# Chave de API: configure estas duas variáveis.
ASSINAFY_API_KEY=
ASSINAFY_ACCOUNT_ID=
ASSINAFY_BASE_URL=https://sandbox.assinafy.com.br/v1
# OAuth2: deixe ASSINAFY_API_KEY vazia; o workspace é obtido após o consentimento.
ASSINAFY_ACCESS_TOKEN=
ASSINAFY_CLIENT_ID=
ASSINAFY_CLIENT_SECRET=
ASSINAFY_REDIRECT_URI=https://app.example.com/oauth/callback
ASSINAFY_OAUTH_ISSUER=https://auth-sandbox.assinafy.com.br
ASSINAFY_OAUTH_RESOURCE=https://sandbox.assinafy.com.br
